{
  "name": "blueprint",
  "private": true,
  "type": "module",
  "bin": {
    "blueprint": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "concurrently -n server,ui \"tsx watch src/cli/index.ts --no-open\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && biome check . && vitest run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "chokidar": "^6.0.0",
    "codemirror": "^6.0.2",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
