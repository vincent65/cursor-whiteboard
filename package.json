{
  "name": "blueprint",
  "private": true,
  "type": "module",
  "bin": {
    "blueprint": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.1"
  },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "node scripts/copy-excalidraw-assets.mjs && concurrently -n server,ui \"tsx watch src/cli/index.ts --no-open\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && node scripts/copy-excalidraw-assets.mjs && vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && biome check . && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=e2e",
    "demo": "playwright test --project=demo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "mermaid": "^11.17.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^3.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@lezer/highlight": "^1.2.5",
    "chokidar": "^6.0.0",
    "codemirror": "^6.0.2",
    "hono": "^4.13.16",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
